<?xml version="1.0" encoding="utf-8"?>
<component name="CatalogCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/UiScale.brs" />
    <script type="text/brightscript" uri="pkg:/components/CatalogCard.brs" />

    <children>
        <Rectangle
            id="focusFrame"
            width="184"
            height="276"
            color="0xE50914FF"
            visible="false" />
        <Rectangle
            id="focusInset"
            translation="[4, 4]"
            width="176"
            height="268"
            color="0x0B0B0DFF"
            visible="false" />
        <Poster
            id="poster"
            translation="[8, 8]"
            width="168"
            height="252"
            loadDisplayMode="scaleToZoom" />
        <Rectangle
            id="progressBarBg"
            translation="[8, 252]"
            width="168"
            height="6"
            color="0x1A1A1DFF"
            visible="false" />
        <Rectangle
            id="progressBarFill"
            translation="[8, 252]"
            width="0"
            height="6"
            color="0xE50914FF"
            visible="false" />
        <!-- Title only when focused — keeps rows poster-forward like Netflix. -->
        <Label
            id="title"
            translation="[0, 286]"
            width="184"
            height="40"
            horizAlign="center"
            vertAlign="top"
            wrap="true"
            maxLines="1"
            font="font:SmallBoldSystemFont"
            color="0xFFFFFFFF"
            visible="false" />
    </children>
</component>
