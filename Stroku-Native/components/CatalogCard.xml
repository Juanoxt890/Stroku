<?xml version="1.0" encoding="utf-8"?>
<component name="CatalogCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/UiScale.brs" />
    <script type="text/brightscript" uri="pkg:/components/DesignTokens.brs" />
    <script type="text/brightscript" uri="pkg:/components/CatalogCard.brs" />

    <children>
        <!-- Outer focus halo (accent) + inner dark inset so the poster pops. -->
        <Rectangle
            id="focusHalo"
            width="202"
            height="296"
            color="0xE50914FF"
            visible="false" />
        <Rectangle
            id="focusFrame"
            translation="[3, 3]"
            width="196"
            height="290"
            color="0x141414FF"
            visible="false" />
        <Poster
            id="poster"
            translation="[6, 6]"
            width="190"
            height="284"
            loadDisplayMode="scaleToZoom"
            loadWidth="190"
            loadHeight="284" />
        <Rectangle
            id="progressBarBg"
            translation="[6, 284]"
            width="190"
            height="6"
            color="0x404040FF"
            visible="false" />
        <Rectangle
            id="progressBarFill"
            translation="[6, 284]"
            width="0"
            height="6"
            color="0xE50914FF"
            visible="false" />
        <!-- Soft title scrim for TV-distance readability without a heavy label. -->
        <Rectangle
            id="titleScrim"
            translation="[6, 246]"
            width="190"
            height="44"
            color="0x000000AA"
            visible="false" />
        <Label
            id="title"
            translation="[6, 300]"
            width="190"
            height="48"
            horizAlign="center"
            vertAlign="top"
            wrap="true"
            maxLines="2"
            font="font:SmallSystemFont"
            color="0xB3B3B3FF" />
    </children>
</component>
