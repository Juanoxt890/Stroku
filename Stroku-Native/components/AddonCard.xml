<?xml version="1.0" encoding="utf-8"?>
<component name="AddonCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onStateChanged" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/UiScale.brs" />
    <script type="text/brightscript" uri="pkg:/components/AddonCard.brs" />

    <children>
        <!-- Same idiom as SettingsRow: the frame sits behind the card so the two
             read as a one-pixel accent border around the focused row. -->
        <Rectangle
            id="focusFrame"
            width="844"
            height="156"
            color="0xE50914FF"
            visible="false" />
        <Rectangle
            id="card"
            translation="[3, 3]"
            width="838"
            height="150"
            color="0x1A1A1DFF" />
        <Rectangle
            id="accentBar"
            translation="[3, 3]"
            width="6"
            height="150"
            color="0xE50914FF"
            visible="false" />

        <!-- Stremio's web app shows a puzzle-piece placeholder when a manifest has
             no logo. A tinted tile with the add-on's initial reads better at ten
             feet than a repeated generic glyph, so the tile is the fallback and
             the manifest logo is drawn over it when there is one. -->
        <Rectangle
            id="logoTile"
            translation="[28, 33]"
            width="84"
            height="84"
            color="0x1A1A1DFF" />
        <Label
            id="logoLetter"
            translation="[28, 33]"
            width="84"
            height="84"
            horizAlign="center"
            vertAlign="center"
            font="font:LargeBoldSystemFont"
            color="0xE50914FF" />
        <Poster
            id="logo"
            translation="[28, 33]"
            width="84"
            height="84"
            loadDisplayMode="scaleToFit"
            visible="false" />

        <Label
            id="name"
            translation="[136, 22]"
            width="480"
            height="36"
            vertAlign="center"
            font="font:MediumBoldSystemFont"
            color="0xFFFFFFFF" />
        <Label
            id="version"
            translation="[136, 58]"
            width="120"
            height="28"
            vertAlign="center"
            font="font:SmallSystemFont"
            color="0x808080FF" />
        <Label
            id="types"
            translation="[264, 58]"
            width="340"
            height="28"
            vertAlign="center"
            font="font:SmallSystemFont"
            color="0xE50914FF" />
        <Label
            id="description"
            translation="[136, 92]"
            width="480"
            height="52"
            vertAlign="top"
            wrap="true"
            maxLines="2"
            truncateOnDelimiter=" "
            font="font:SmallSystemFont"
            color="0xB3B3B3FF" />

        <!-- Status pill: short word ("Instalar" / "Instalado") must fit at FHD. -->
        <Rectangle
            id="badgePill"
            translation="[636, 52]"
            width="188"
            height="48"
            color="0xE50914FF" />
        <Label
            id="badgeLabel"
            translation="[636, 52]"
            width="188"
            height="48"
            horizAlign="center"
            vertAlign="center"
            font="font:SmallBoldSystemFont"
            color="0xFFFFFFFF" />

        <!-- Empty, loading and "load the collection" rows reuse the same slot. -->
        <Label
            id="messageLabel"
            translation="[36, 3]"
            width="770"
            height="150"
            vertAlign="center"
            wrap="true"
            maxLines="2"
            font="font:MediumSystemFont"
            color="0xB3B3B3FF"
            visible="false" />
    </children>
</component>
