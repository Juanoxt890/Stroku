        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onStateChanged" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/UiScale.brs" />
    <script type="text/brightscript" uri="pkg:/components/SeasonTab.brs" />

    <children>
        <Rectangle
            id="pill"
            width="220"
            height="64"
            color="0x1A1A1DFF" />
        <Label
            id="label"
            width="220"
            height="64"
            horizAlign="center"
            vertAlign="center"
            font="font:MediumBoldSystemFont"
            color="0xB3B3B3FF" />
    </children>
</component>
