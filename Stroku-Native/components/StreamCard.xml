<?xml version="1.0" encoding="utf-8"?>
<component name="StreamCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/UiScale.brs" />
    <script type="text/brightscript" uri="pkg:/components/StreamCard.brs" />

    <children>
        <Rectangle
            id="cardBg"
            translation="[0, 0]"
            width="1600"
            height="168"
            color="0x141416FF" />
        <Rectangle
            id="focusFrame"
            translation="[0, 0]"
            width="1600"
            height="168"
            color="0x1A1A1DFF"
            visible="false" />
        <Rectangle
            id="focusAccent"
            translation="[0, 0]"
            width="8"
            height="168"
            color="0xE50914FF"
            visible="false" />

        <!-- Line 1: quality / resolution / size -->
        <Label
            id="line1"
            translation="[36, 22]"
            width="1320"
            height="42"
            font="font:MediumBoldSystemFont"
            color="0xFFFFFFFF" />
        <Label
            id="badge"
            translation="[1380, 24]"
            width="190"
            height="36"
            horizAlign="right"
            font="font:SmallBoldSystemFont"
            color="0xE50914FF" />

        <!-- Line 2: languages / audio / subtitle hints -->
        <Label
            id="line2"
            translation="[36, 70]"
            width="1530"
            height="36"
            font="font:MediumSystemFont"
            color="0xE5E5E5FF" />

        <!-- Line 3: codec / container / source / addon -->
        <Label
            id="line3"
            translation="[36, 114]"
            width="1530"
            height="34"
            font="font:SmallSystemFont"
            color="0xB3B3B3FF" />
    </children>
</component>
